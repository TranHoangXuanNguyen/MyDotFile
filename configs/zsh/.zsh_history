\
# 2. ă�ảm bảo plugin ă�ã ă�ược tải về (nếu có rể�i nó sẽ tự bể� qua)\
git clone https://github.com/zsh-users/zsh-autosuggestions ~/.zsh/zsh-autosuggestions 2>/dev/null\
git clone https://github.com/zsh-users/zsh-syntax-highlighting.git ~/.zsh/zsh-syntax-highlighting 2>/dev/null\
\
# 3. GHI FILE CẤU HÃ�NH CHUẨN VÀO ă�Ã�NG CHể� (.config/zsh/.zshrc)\
cat << 'EOF' > ~/.config/zsh/.zshrc\
# --- 1. Tể�i ưu Lể�ch sử & Tể�c ă�ể� ---\
HISTFILE=~/.zsh_history\
HISTSIZE=10000\
SAVEHIST=10000\
setopt SHARE_HISTORY       # ă�ể�ng bể� lể�ch sử giữa cÃ�c tab\
setopt HIST_IGNORE_DUPS    # Không lưu lể�nh trùng lặp\
\
# --- 2. Plugin (Gợi ý & Tô mÃ�u) ---\
source ~/.zsh/zsh-autosuggestions/zsh-autosuggestions.zsh\
source ~/.zsh/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh\
\
# --- 3. Alias (Lể�nh tắt tiể�n dụng) ---\
alias l="ls -la"\
alias c="clear"\
alias ..="cd .."\
\
# --- 4. Giao diể�n Starship (Khể�i ă�ể�ng siêu nhanh) ---\
eval "$(starship init zsh)"\
EOF\
\
